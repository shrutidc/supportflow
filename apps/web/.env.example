# Copy to .env.local and fill in your own values.
# .env* is gitignored in this workspace — NEVER commit the real file.

# --- Clerk (authentication + organizations) ---
# Dashboard -> API Keys. The publishable key is safe to expose to the
# browser; the secret key is server-side only and must never be prefixed
# with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Serve sign-in/sign-up from this app rather than Clerk's hosted portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Express API ---
# Base URL the authenticated /api proxy route forwards to
# (src/app/api/[...path]/route.ts). Server-side only; the browser always
# calls same-origin /api/* and never sees the API host or session token.
API_URL=http://localhost:3000

# Optional shared secret, when the API also runs behind its API_TOKEN gate.
# Must match API_TOKEN in server/.env. The proxy sends it as X-Api-Token;
# Authorization is reserved for the Clerk session JWT. Leave empty locally.
API_TOKEN=
