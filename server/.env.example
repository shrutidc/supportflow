# --- SupportFlow server configuration ---
# Copy to .env and fill in your own values. NEVER commit the real .env.
# Rotate any credential that was ever committed to git history.

# MongoDB connection string.
# - Unset in development: falls back to a seeded in-memory database.
# - Required when NODE_ENV=production (boot fails fast without it).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supportflow?retryWrites=true&w=majority

# HTTP port (default 3000)
PORT=3000

# development | test | production
NODE_ENV=development

# Comma-separated list of origins allowed to call the API cross-origin.
# Empty (default) = same-origin only; the frontend is served by this server.
# Example for the future Next.js dev frontend:
# CORS_ORIGINS=http://localhost:3001
CORS_ORIGINS=

# Optional bearer token protecting /api (stopgap until Clerk auth in
# Phase 3). Empty = open, for local development. When set, requests must
# send "Authorization: Bearer <token>".
API_TOKEN=

# Set to true only when running behind a reverse proxy (Railway, etc.) so
# rate limiting reads client IPs from X-Forwarded-For.
TRUST_PROXY=false
