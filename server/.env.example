# --- SupportFlow server configuration ---
# Copy to .env and fill in your own values. NEVER commit the real .env.
# Rotate any credential that was ever committed to git history.

# MongoDB connection string.
# - Unset in development: falls back to a seeded in-memory database.
# - Required when NODE_ENV=production (boot fails fast without it).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/supportflow?retryWrites=true&w=majority

# HTTP port (default 3000)
PORT=3000

# development | test | production
NODE_ENV=development

# --- Clerk (authentication + organizations) ---
# BOTH are REQUIRED; the API refuses to boot without them outside tests.
# @clerk/express needs the publishable key as well as the secret to build its
# authentication context — without it the process starts and /healthz answers
# 200 while every single /api request fails. Clerk dashboard -> API Keys.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Comma-separated list of origins allowed to call the API cross-origin.
# Empty (default) = same-origin only. The Next.js app calls this API through
# its own server-side proxy, so it is same-origin and needs no entry here.
# Only add an origin if a browser will call the API directly.
CORS_ORIGINS=

# Optional shared secret protecting /api, layered IN FRONT OF Clerk (not a
# replacement for it). Empty = open, for local development. When set,
# requests must send "X-Api-Token: <token>" — never Authorization, which
# carries the Clerk session JWT. Set the same value in apps/web.
API_TOKEN=

# Set to true only when running behind a reverse proxy (Railway, etc.) so
# rate limiting reads client IPs from X-Forwarded-For.
TRUST_PROXY=false
